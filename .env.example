# Flask Configuration
SECRET_KEY=your-secret-key-here
SESSION_TYPE=filesystem

# MySQL Configuration
MYSQL_ROOT_PASSWORD=your-mysql-password
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_HOST=db
